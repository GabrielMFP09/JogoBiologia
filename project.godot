; Arquivo de configuracao da engine.
; E preferivel edita-lo pela interface do editor,
; pois nem todos os parametros sao obvios.
;
; Formato:
;   [secao] ; a secao fica entre colchetes
;   parametro=valor ; atribui valores aos parametros

config_version=5

[application]

config/name="JogoBiologia"
run/main_scene="res://Cenas/Mundo/Partida.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
